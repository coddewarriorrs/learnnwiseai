# LearnWise AI Environment Configuration

# Database Configuration
# Local SQLite default: sqlite:///./learnwise.db
# PostgreSQL: postgresql+psycopg2://learnwise:password@localhost:5432/learnwisedb
DATABASE_URL=sqlite:///./learnwise.db

# JWT & Authentication Secrets
JWT_SECRET=learnwise-super-secret-key-change-in-prod-2026-hackathon
JWT_REFRESH_SECRET=learnwise-refresh-super-secret-key-2026

# AI Engine Configuration
# Options: 'gemini', 'openai', 'anthropic', 'fallback'
AI_PROVIDER=fallback
AI_API_KEY=your-gemini-or-openai-api-key-here
AI_MODEL=gemini-1.5-flash

# Application Ports
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws/teacher
